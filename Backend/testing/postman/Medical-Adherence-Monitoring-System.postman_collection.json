				{
					"name": "Initialize Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201 || pm.response.code === 200) {",
									"    pm.test(\"Status code is success\", function () {",
									"        pm.response.to.have.status(201);",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"9876543210\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/initializelogin",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"initializelogin"
							]
						},
						"description": "Initialize login by sending phone number. OTP will be sent (or logged in dev mode)."
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const responseJson = pm.response.json();",
									"    if (responseJson.authToken) {",
									"        pm.collectionVariables.set(\"authToken\", responseJson.authToken);",
									"        pm.collectionVariables.set(\"userId\", responseJson.userId);",
									"        console.log(\"Auth Token stored:\", responseJson.authToken);",
									"        console.log(\"User ID stored:\", responseJson.userId);",
									"    }",
									"    pm.test(\"Status code is 200\", function () {",
									"        pm.response.to.have.status(200);",
									"    });",
									"    pm.test(\"Response has authToken\", function () {",
									"        pm.expect(responseJson).to.have.property('authToken');",
									"    });",
									"    pm.test(\"Response has userId\", function () {",
									"        pm.expect(responseJson).to.have.property('userId');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"9876543210\",\n    \"otp\": \"0000\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Login with phone and OTP. Returns authToken and userId which are stored in collection variables."
					},
					"response": []
				},
